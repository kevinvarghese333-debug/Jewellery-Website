rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents & synchronized wishlists
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User wishlist subcollection if needed
      match /wishlist/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Orders collection: Anyone can create an order upon checkout, authenticated users can read their own orders
    match /orders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.customerEmail == request.auth.token.email
      );
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
