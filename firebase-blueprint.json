{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer profiles for Kavitha Jewellery",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full customer name" },
        "email": { "type": "string", "description": "Customer email address" },
        "mobile": { "type": "string", "description": "Customer 10-digit mobile number" },
        "city": { "type": "string", "description": "Customer city / location" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "authProvider": { "type": "string", "description": "Sign in method (google/password/phone)" },
        "wishlist": { 
          "type": "array", 
          "items": { "type": "string" }, 
          "description": "Array of saved product IDs" 
        },
        "loyaltyPoints": { "type": "number", "description": "Customer loyalty reward points" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email"]
    },
    "OrderRecord": {
      "title": "OrderRecord",
      "description": "Secured jewellery purchases and customer order history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "goldValue": { "type": "number" },
        "makingCharges": { "type": "number" },
        "gst": { "type": "number" },
        "discount": { "type": "number" },
        "couponCode": { "type": "string" },
        "grandTotal": { "type": "number" },
        "totalWeightGrams": { "type": "number" },
        "status": { "type": "string", "enum": ["CONFIRMED", "HALLMARK_VERIFIED", "INSURED_TRANSIT", "DELIVERED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "estimatedDeliveryDate": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "paymentMethod": { "type": "string" }
      },
      "required": ["orderNumber", "grandTotal", "status", "createdAt"]
    },
    "ProductReview": {
      "title": "ProductReview",
      "description": "Verified customer reviews and ratings for jewellery pieces",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "location": { "type": "string" },
        "rating": { "type": "number" },
        "title": { "type": "string" },
        "comment": { "type": "string" },
        "date": { "type": "string" },
        "verifiedBuyer": { "type": "boolean" },
        "purityBought": { "type": "string" },
        "occasion": { "type": "string" },
        "helpfulCount": { "type": "number" },
        "recommended": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "authorName", "rating", "title", "comment"]
    },
    "StoreConfig": {
      "title": "StoreConfig",
      "description": "Global store bullion rates and campaign configurations",
      "type": "object",
      "properties": {
        "rate22k": { "type": "number" },
        "rate18k": { "type": "number" },
        "rate14k": { "type": "number" },
        "silverRate": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["rate22k"]
    },
    "AppointmentLead": {
      "title": "AppointmentLead",
      "description": "Customer consultation bookings, video call leads, and showroom visit requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string", "enum": ["video", "showroom"] },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "selectedProductId": { "type": "string" },
        "selectedProductName": { "type": "string" },
        "selectedProductPurity": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["NEW", "CONTACTED", "CONFIRMED", "COMPLETED", "CANCELLED"] },
        "source": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "staffNotes": { "type": "string" },
        "syncedToGoogleSheets": { "type": "boolean" }
      },
      "required": ["name", "phone", "location", "type", "date", "time", "status", "createdAt"]
    }
  },
  "firestore": {
    "/app_config/{configId}": {
      "schema": "StoreConfig",
      "description": "Store live gold bullion rates and settings"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with synchronized wishlist and preferences"
    },
    "/orders/{orderId}": {
      "schema": "OrderRecord",
      "description": "Orders collection accessible by the placing user"
    },
    "/reviews/{reviewId}": {
      "schema": "ProductReview",
      "description": "Customer reviews and ratings for jewellery pieces"
    },
    "/appointments/{appointmentId}": {
      "schema": "AppointmentLead",
      "description": "Customer consultation and showroom appointment leads with Google Sheets webhook synchronization"
    }
  }
}
